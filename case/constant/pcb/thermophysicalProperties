/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM.com v2512 FR4 reference properties                                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version 2.0;                  // Standard dictionary format version.
    format ascii;                 // Readable material properties.
    class dictionary;             // Thermophysical model dictionary.
    object thermophysicalProperties; // Solver-required object name.
}

thermoType
{
    type heSolidThermo;           // Solid enthalpy model for conduction.
    mixture pureMixture;          // Model the board as a homogeneous equivalent.
    transport constIso;           // Use a single effective isotropic conductivity.
    thermo hConst;                // Constant heat capacity for the reference study.
    equationOfState rhoConst;     // Solid density is treated as constant.
    specie specie;                // One effective solid species.
    energy sensibleEnthalpy;      // Solve sensible enthalpy without reaction energy.
}

mixture
{
    specie
    {
        nMoles 1;                 // One mole basis for the effective material.
        molWeight 100;            // Nominal placeholder; rhoConst sets solid density.
    }
    thermodynamics
    {
        Hf 0;                     // No formation enthalpy is involved.
        Sf 0;                     // No formation entropy is involved.
        Cp 1000;                  // Representative FR4 heat capacity in J/(kg K).
    }
    transport
    {
        kappa 0.30;               // Through-thickness-equivalent FR4 conductivity in W/(m K).
    }
    equationOfState
    {
        rho 1900;                 // Representative FR4 density in kg/m^3.
    }
}
