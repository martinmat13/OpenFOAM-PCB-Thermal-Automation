/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM.com v2512 aluminium reference properties                          |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version 2.0;                  // Standard dictionary format version.
    format ascii;                 // Readable material properties.
    class dictionary;             // Thermophysical model dictionary.
    object thermophysicalProperties; // Solver-required object name.
}

thermoType
{
    type heSolidThermo;           // Solid enthalpy model for the heatsink.
    mixture pureMixture;          // Treat the heat sink as one alloy.
    transport constIso;           // Constant isotropic conductivity for a baseline.
    thermo hConst;                // Constant heat capacity.
    equationOfState rhoConst;     // Density is fixed for a solid.
    specie specie;                // One effective alloy species.
    energy sensibleEnthalpy;      // Solve sensible enthalpy.
}

mixture
{
    specie
    {
        nMoles 1;                 // One mole basis for the effective alloy.
        molWeight 26.98;           // Aluminium atomic mass as an effective-species basis.
    }
    thermodynamics
    {
        Hf 0;                     // Formation enthalpy is not used.
        Sf 0;                     // Formation entropy is not used.
        Cp 900;                   // Representative aluminium heat capacity in J/(kg K).
    }
    transport
    {
        kappa 205;                // Representative aluminium conductivity in W/(m K).
    }
    equationOfState
    {
        rho 2700;                 // Aluminium density in kg/m^3.
    }
}
