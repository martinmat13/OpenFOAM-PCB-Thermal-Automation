/*--------------------------------*- C++ -*----------------------------------*\
| Initial solid pressure field                                                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version 2.0;                  // Standard field format version.
    format ascii;                 // Text field for review.
    class volScalarField;         // Pressure is a cell-centred scalar.
    object p;                     // Solid thermodynamics pressure field.
}

dimensions [1 -1 -2 0 0 0 0];      // Pressure dimensions in pascals.
internalField uniform 101325;      // Use the same nominal reference pressure as the air.
boundaryField
{
    pcb_to_domain0 { type zeroGradient; } // Solid pressure does not prescribe interface heat transfer.
    pcb_to_cpu { type zeroGradient; } // Solid pressure does not prescribe interface heat transfer.
}
