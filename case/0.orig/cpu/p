/*--------------------------------*- C++ -*----------------------------------*\
| Initial solid pressure field                                                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version 2.0;                  // Standard field format version.
    format ascii;                 // Text field for review.
    class volScalarField;         // Pressure is a cell-centred scalar.
    object p;                     // Solid thermodynamics pressure field.
}

dimensions [1 -1 -2 0 0 0 0];      // Pressure dimensions in pascals.
internalField uniform 101325;      // Match the nominal ambient pressure.
boundaryField
{
    cpu_to_domain0 { type zeroGradient; } // Solid pressure does not control air-side mass flow.
    cpu_to_pcb { type zeroGradient; } // Solid pressure does not control interface heat flux.
    cpu_to_aluminum { type zeroGradient; } // Solid pressure does not control interface heat flux.
}
